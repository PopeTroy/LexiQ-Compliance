<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A0A0A"
    android:orientation="vertical">

    <!-- Ingestion Suggestion & Parakeet Voice Status Bar -->
    <LinearLayout
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#121212"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <!-- Tiki Mask Icon Status / Parakeet Profile Indicator -->
        <TextView
            android:id="@+id/tikiIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:contentDescription="LexiQ status indicator"
            android:text="🗿"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/suggestionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="LexiQ Engine: Text clear ✅"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Dedicated Parakeet Push-to-Talk Microphone Button -->
        <Button
            android:id="@+id/micButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="#1C1C1E"
            android:contentDescription="Parakeet push-to-talk microphone"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="🎤"
            android:textColor="#00E676"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Pinned Container where rows of neon buttons are rendered once and styled in place -->
    <LinearLayout
        android:id="@+id/keyboardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp" />
</LinearLayout>
